[
  {
    "id": "pb-en-0732",
    "title": "The Little Wiggle Dance",
    "series": "popo",
    "level": 2,
    "words": 199,
    "cover": "assets/books/pb-en-0732/cover.webp",
    "pages": [
      {
        "image": "assets/books/pb-en-0732/01.webp",
        "text": "It was a rainy day.\nPopo, Mumu, and Nemu stayed in their little room.",
        "audio": "assets/audio/pb-en-0732/01.mp3"
      },
      {
        "image": "assets/books/pb-en-0732/02.webp",
        "text": "Rain tapped on the window.\nPopo's two fluffy feelers moved with the sound.",
        "audio": "assets/audio/pb-en-0732/02.mp3"
      },
      {
        "image": "assets/books/pb-en-0732/03.webp",
        "text": "Mumu saw them and smiled.\nThen she moved her little bottom from side to side.",
        "audio": "assets/audio/pb-en-0732/03.mp3"
      },
      {
        "image": "assets/books/pb-en-0732/04.webp",
        "text": "Popo laughed.\nHe flapped his little wings and tapped his feet on the floor.",
        "audio": "assets/audio/pb-en-0732/04.mp3"
      }
    ],
    "author": "Nobuaki Kuwabara",
    "license": "All Rights Reserved",
    "source_sha256": "fc1842252083f94a220e372741c658a16d8e7a6bf7781aa83903147895905e0a"
  },
  {
    "id": "pb-en-0728",
    "title": "Half a Roll",
    "series": "popo",
    "level": 1,
    "words": 72,
    "cover": "assets/books/pb-en-0728/cover.webp",
    "pages": [
      {
        "image": "assets/books/pb-en-0728/01.webp",
        "text": "This is Popo.\nPopo likes bread.",
        "audio": "assets/audio/pb-en-0728/01.mp3"
      },
      {
        "image": "assets/books/pb-en-0728/02.webp",
        "text": "One coin!\nNow Popo can buy bread.",
        "audio": "assets/audio/pb-en-0728/02.mp3"
      },
      {
        "image": "assets/books/pb-en-0728/03.webp",
        "text": "But today, the bread costs two coins.",
        "audio": "assets/audio/pb-en-0728/03.mp3"
      },
      {
        "image": "assets/books/pb-en-0728/04.webp",
        "text": "Popo has one coin.\nNo bread today.",
        "audio": "assets/audio/pb-en-0728/04.mp3"
      }
    ],
    "author": "Nobuaki Kuwabara",
    "license": "All Rights Reserved",
    "source_sha256": "3ea4f98e958fa5888048b2f5fcebb9ad5a127a911bafc34d6f23679c313131f4"
  },
  {
    "id": "pb-en-0730",
    "title": "Who Said Good Night?",
    "series": "popo",
    "level": 1,
    "words": 77,
    "cover": "assets/books/pb-en-0730/cover.webp",
    "pages": [
      {
        "image": "assets/books/pb-en-0730/01.webp",
        "text": "It is night.\nPopo and Mumu are in bed.",
        "audio": "assets/audio/pb-en-0730/01.mp3"
      },
      {
        "image": "assets/books/pb-en-0730/02.webp",
        "text": "“Good night, Popo,” says Mumu.",
        "audio": "assets/audio/pb-en-0730/02.mp3"
      },
      {
        "image": "assets/books/pb-en-0730/03.webp",
        "text": "“Good night, Mumu,” says Popo.",
        "audio": "assets/audio/pb-en-0730/03.mp3"
      },
      {
        "image": "assets/books/pb-en-0730/04.webp",
        "text": "“Good night.”\nA voice comes from the cupboard.",
        "audio": "assets/audio/pb-en-0730/04.mp3"
      }
    ],
    "author": "Nobuaki Kuwabara",
    "license": "All Rights Reserved",
    "source_sha256": "547f3a10dd33696c72c17b5e7dfbde04ca6810ad1a1bafe8395dea9a935b8a7f"
  },
  {
    "id": "pb-en-0731",
    "title": "A Little Visitor",
    "series": "popo",
    "level": 1,
    "words": 146,
    "cover": "assets/books/pb-en-0731/cover.webp",
    "pages": [
      {
        "image": "assets/books/pb-en-0731/01.webp",
        "text": "Popo lifts the blanket.\nTwo small eyes look up.",
        "audio": "assets/audio/pb-en-0731/01.mp3"
      },
      {
        "image": "assets/books/pb-en-0731/02.webp",
        "text": "It is small.\nIt is cold.",
        "audio": "assets/audio/pb-en-0731/02.mp3"
      },
      {
        "image": "assets/books/pb-en-0731/03.webp",
        "text": "“Are you cold?” asks Mumu.\nThe little one says nothing.",
        "audio": "assets/audio/pb-en-0731/03.mp3"
      },
      {
        "image": "assets/books/pb-en-0731/04.webp",
        "text": "Popo has a small cloth.\nHe gives it to the little one.",
        "audio": "assets/audio/pb-en-0731/04.mp3"
      }
    ],
    "author": "Nobuaki Kuwabara",
    "license": "All Rights Reserved",
    "source_sha256": "286ef85ea096711d2136b973e9468f118583d3cbe815056895ff3f51b63d8d2e"
  },
  {
    "id": "pb-en-0729",
    "title": "A Job in the Rain",
    "series": "popo",
    "level": 1,
    "words": 136,
    "cover": "assets/books/pb-en-0729/cover.webp",
    "pages": [
      {
        "image": "assets/books/pb-en-0729/01.webp",
        "text": "Popo's blanket had a hole.\nAt night, he was cold.",
        "audio": "assets/audio/pb-en-0729/01.mp3"
      },
      {
        "image": "assets/books/pb-en-0729/02.webp",
        "text": "At the shop, a keeper said,\n“Put these leaves in a bag. Then I will give you two coins.”",
        "audio": "assets/audio/pb-en-0729/02.mp3"
      },
      {
        "image": "assets/books/pb-en-0729/03.webp",
        "text": "Two coins could buy a new blanket.\nPopo would be warm.",
        "audio": "assets/audio/pb-en-0729/03.mp3"
      },
      {
        "image": "assets/books/pb-en-0729/04.webp",
        "text": "Popo worked all day.\nSome leaves were bigger than he was.",
        "audio": "assets/audio/pb-en-0729/04.mp3"
      }
    ],
    "author": "Nobuaki Kuwabara",
    "license": "All Rights Reserved",
    "source_sha256": "b28438ede7de5148d5a4fb21aeb2b1109841eb0e33b04d6913b03822a9c865c1"
  },
  {
    "id": "pb-en-0708",
    "title": "The Best Seat",
    "series": "mallow",
    "level": 1,
    "words": 107,
    "cover": "assets/books/pb-en-0708/cover.webp",
    "pages": [
      {
        "image": "assets/books/pb-en-0708/01.webp",
        "text": "Mugi wants a good seat. This seat is very high.",
        "audio": "assets/audio/pb-en-0708/01.mp3"
      },
      {
        "image": "assets/books/pb-en-0708/02.webp",
        "text": "He gets down. “No. This is not my seat.”",
        "audio": "assets/audio/pb-en-0708/02.mp3"
      },
      {
        "image": "assets/books/pb-en-0708/03.webp",
        "text": "This seat is low. His knees are very high!",
        "audio": "assets/audio/pb-en-0708/03.mp3"
      },
      {
        "image": "assets/books/pb-en-0708/04.webp",
        "text": "He sees a big seat. “This one is good!”",
        "audio": "assets/audio/pb-en-0708/04.mp3"
      }
    ],
    "author": "Nobuaki Kuwabara",
    "license": "All Rights Reserved",
    "source_sha256": "06357e1f9e31a5169238faa6db4c6eb7a6aacc8d4b6ad014bb55c5748e5e836d"
  },
  {
    "id": "pb-en-0714",
    "title": "Tomorrow’s Bread",
    "series": "mallow",
    "level": 2,
    "words": 247,
    "cover": "assets/books/pb-en-0714/cover.webp",
    "pages": [
      {
        "image": "assets/books/pb-en-0714/01.webp",
        "text": "Every morning, Mugi looked at the round loaf in Riri's window. He liked its golden, crackly top.",
        "audio": "assets/audio/pb-en-0714/01.mp3"
      },
      {
        "image": "assets/books/pb-en-0714/02.webp",
        "text": "He saved one coin after work. He wanted to buy the loaf on his next free morning.",
        "audio": "assets/audio/pb-en-0714/02.mp3"
      },
      {
        "image": "assets/books/pb-en-0714/03.webp",
        "text": "At last, he had four coins. Yesterday, the loaf had cost four. Mugi counted his money twice.",
        "audio": "assets/audio/pb-en-0714/03.mp3"
      },
      {
        "image": "assets/books/pb-en-0714/04.webp",
        "text": "“One round loaf, please,” he said. Riri looked down. “It costs five coins today. I am sorry.”",
        "audio": "assets/audio/pb-en-0714/04.mp3"
      }
    ],
    "author": "Nobuaki Kuwabara",
    "license": "All Rights Reserved",
    "source_sha256": "042f2bb8601878770bc4633e649424792997cb74395cf31def6a79f1a4f5fe0e"
  },
  {
    "id": "pb-en-0715",
    "title": "The Fast Line",
    "series": "mallow",
    "level": 2,
    "words": 259,
    "cover": "assets/books/pb-en-0715/cover.webp",
    "pages": [
      {
        "image": "assets/books/pb-en-0715/01.webp",
        "text": "Mugi needed a new wheel for his parcel cart. He joined the line outside the little wheel shop.",
        "audio": "assets/audio/pb-en-0715/01.mp3"
      },
      {
        "image": "assets/books/pb-en-0715/02.webp",
        "text": "The line moved slowly. Mugi stood very straight. He had come early, and he had brought the right coins.",
        "audio": "assets/audio/pb-en-0715/02.mp3"
      },
      {
        "image": "assets/books/pb-en-0715/03.webp",
        "text": "Tula arrived later. She bought a shiny ticket at the side window. It cost three extra coins.",
        "audio": "assets/audio/pb-en-0715/03.mp3"
      },
      {
        "image": "assets/books/pb-en-0715/04.webp",
        "text": "The ticket let her use another line. Tula went past Mugi. “See you inside,” she said, a little awkwardly.",
        "audio": "assets/audio/pb-en-0715/04.mp3"
      }
    ],
    "author": "Nobuaki Kuwabara",
    "license": "All Rights Reserved",
    "source_sha256": "c064c048003446cc8797976c4c1f9e86ff8939ec18b33221edec857d97184304"
  }
]
